---
import { loadPublications, publicationBySlug } from '../../../data/publications'
import { defaultLocale } from '../../../i18n/config'
import PublicationDetailPage from '../../../components/pages/PublicationDetailPage.astro'

export const getStaticPaths = async () => {
  const publications = await loadPublications(defaultLocale)
  return publications.map((publication) => ({
    params: { slug: publication.slug },
    props: {
      publication,
      related: publication.detail.related.map((slug) => publicationBySlug(publications, slug)),
    },
  }))
}
---

<PublicationDetailPage {...Astro.props} />
