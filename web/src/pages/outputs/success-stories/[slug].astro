---
import { loadProjects, projectBySlug } from '../../../data/projects'
import { defaultLocale } from '../../../i18n/config'
import ProjectDetailPage from '../../../components/pages/ProjectDetailPage.astro'

export const getStaticPaths = async () => {
  const projects = await loadProjects(defaultLocale)
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      related: project.detail.related.map((slug) => projectBySlug(projects, slug)),
    },
  }))
}
---

<ProjectDetailPage {...Astro.props} />
