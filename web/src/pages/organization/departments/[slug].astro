---
import type { GetStaticPaths } from 'astro'
import { loadDepartmentPages } from '../../../data/departments'
import { defaultLocale } from '../../../i18n/config'
import DepartmentDetailPage from '../../../components/pages/DepartmentDetailPage.astro'

export const getStaticPaths = (async () => {
  const pages = await loadDepartmentPages(defaultLocale)
  return pages.map((page) => ({ params: { slug: page.department.slug }, props: page }))
}) satisfies GetStaticPaths
---

<DepartmentDetailPage {...Astro.props} />
