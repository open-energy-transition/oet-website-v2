---
import type { GetStaticPaths } from 'astro'
import ToolsAndDataPage from '../../components/pages/ToolsAndDataPage.astro'
import { loadToolCategories, loadToolsPage } from '../../data/tools'
import { defaultLocale } from '../../i18n/config'

export const getStaticPaths = (async () => {
  const categories = await loadToolCategories(defaultLocale)
  return categories.map((category) => ({ params: { category: category.slug } }))
}) satisfies GetStaticPaths

const { category } = Astro.params
const page = await loadToolsPage(defaultLocale)
---

<ToolsAndDataPage page={page} category={category} />
