---
import { Image } from 'astro:assets'
import glare from '../../assets/footer/glare.png'
import Pixels from '../../assets/footer/pixels.svg'
import Bluesky from '../../icons/bluesky.svg'
import Envelope from '../../icons/envelope.svg'
import Eventbrite from '../../icons/eventbrite.svg'
import Github from '../../icons/github.svg'
import Linkedin from '../../icons/linkedin.svg'
import Mastodon from '../../icons/mastodon.svg'
import X from '../../icons/x.svg'
import Youtube from '../../icons/youtube.svg'
import type { FooterContent, SocialKind } from '../../data/footer'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/ui'
import FooterCta from './FooterCta.astro'

interface Props {
  content: FooterContent
  locale: Locale
}

const { content, locale } = Astro.props

const glares = [
  {
    frame:
      'top-[-562px] left-[-436px] h-[1087.535px] w-[1170.982px] lg:top-[-168px] lg:left-[-408px]',
    layer: 'h-[1107.661px] w-[1018.267px] lg:opacity-20',
    mask: 'linear-gradient(7.920124334850158deg, rgb(0 0 0) 15.082%, rgb(0 0 0 / 0) 50.078%, rgb(0 0 0) 87.154%), linear-gradient(94.85591738376108deg, rgb(0 0 0) 35.254%, rgb(0 0 0 / 0) 66.369%, rgb(0 0 0) 99.332%)',
  },
  {
    frame: 'top-[-159px] right-[-172.596px] h-[616.306px] w-[663.596px] max-lg:hidden',
    layer: 'h-[627.712px] w-[577.052px] opacity-40',
    mask: 'linear-gradient(7.42665599169824deg, rgb(0 0 0) 20.112%, rgb(0 0 0 / 0) 52.726%, rgb(0 0 0) 87.278%), linear-gradient(94.58653494085263deg, rgb(0 0 0) 38.62%, rgb(0 0 0 / 0) 64.572%, rgb(0 0 0) 92.066%)',
  },
]

const socialIcons: Record<SocialKind, typeof Linkedin> = {
  linkedin: Linkedin,
  github: Github,
  x: X,
  youtube: Youtube,
  bluesky: Bluesky,
  mastodon: Mastodon,
  eventbrite: Eventbrite,
  newsletter: Envelope,
}

const pairs = [content.columns.slice(0, 2), content.columns.slice(2)]

const box =
  'p-4 shadow-[inset_1px_0_0_rgba(236,236,236,0.32),inset_-1px_0_0_rgba(236,236,236,0.32),inset_0_-1px_0_rgba(236,236,236,0.32)] lg:p-0 lg:shadow-none'
const link =
  'relative hover:underline before:absolute before:inset-x-0 before:-inset-y-1 before:content-[""] lg:before:-inset-y-0.5'
---

<footer class="relative isolate overflow-hidden bg-brand-500" data-header-theme="on-red">
  {glares.map((item) => (
    <div
      aria-hidden="true"
      class:list={[
        'pointer-events-none absolute -z-10 flex items-center justify-center mix-blend-plus-lighter',
        item.frame,
      ]}
    >
      <div class:list={['relative flex-none rotate-[93.7deg]', item.layer]}>
        <Image
          src={glare}
          alt=""
          widths={[469, 938]}
          sizes="469px"
          loading="lazy"
          class="absolute inset-0 size-full object-cover object-[99.8%_50%]"
        />
        <div class="absolute -inset-px" style={`background-image: ${item.mask}`} />
      </div>
    </div>
  ))}
  <Pixels
    aria-hidden="true"
    class="pointer-events-none absolute -z-10 top-[-1.75px] left-[-68.86px] text-white lg:top-[422.3px] lg:left-[-41px]"
  />
  <Pixels
    aria-hidden="true"
    class="pointer-events-none absolute -z-10 top-[422.3px] right-[-29.97px] text-white max-lg:hidden"
  />
  <FooterCta content={content.cta} />
  <div class="mx-auto mb-5 flex w-full max-w-page flex-col px-5 ring-1 ring-[rgba(236,236,236,0.44)] ring-inset lg:mb-0 lg:flex-row lg:px-10">
    <div class="contents lg:relative lg:flex lg:w-[305px] lg:shrink-0 lg:flex-col lg:gap-[10px] lg:pt-5 lg:pr-5 lg:pb-10 lg:after:pointer-events-none lg:after:absolute lg:after:inset-0 lg:after:border-y lg:after:border-r lg:after:border-[rgba(236,236,236,0.32)] lg:after:content-['']">
      <div class="contents lg:flex lg:h-[90px] lg:flex-col lg:justify-between">
        <p class:list={['order-2 text-body-xs font-medium text-white lg:order-none', box]}>
          {content.blurb}
        </p>
        {content.socials.length > 0 && (
          <ul
            aria-label={t(locale, 'footer.social')}
            class:list={['order-2 flex flex-wrap gap-2 text-white lg:order-none', box]}
          >
            {content.socials.map((social) => {
              const Icon = socialIcons[social.kind]
              return (
                <li>
                  <a
                    href={social.href}
                    aria-label={social.label}
                    title={social.label}
                    class="flex size-8 items-center justify-center ring-1 ring-[rgba(236,236,236,0.44)] ring-inset transition-colors hover:bg-white hover:text-brand-500 focus-visible:bg-white focus-visible:text-brand-500"
                  >
                    <Icon aria-hidden="true" class="size-[14px]" />
                  </a>
                </li>
              )
            })}
          </ul>
        )}
      </div>
      <p class:list={['order-4 text-body-xs text-white lg:order-none', box]}>{content.copyright}</p>
      <ul
        aria-label={t(locale, 'nav.legal')}
        class:list={['order-3 text-body-xs text-neutral-50 lg:order-none lg:text-body-2xs', box]}
      >
        {content.legal.map((item) => (
          <li class="inline">
            <a href={item.href} class={link}>
              {item.label}
            </a>
            <span class="lg:hidden" aria-hidden="true">
              {' / '}
            </span>
            <span class="max-lg:hidden" aria-hidden="true">
              {' | '}
            </span>
          </li>
        ))}
        <li class="inline">
          <button type="button" class:list={['cursor-pointer', link]} data-consent-settings>
            <span class="lg:hidden">{content.consentLabelCompact}</span>
            <span class="max-lg:hidden">{content.consentLabel}</span>
          </button>
        </li>
      </ul>
    </div>
    <nav
      aria-label={t(locale, 'footer.navigation')}
      class="order-1 flex flex-col text-neutral-50 lg:order-none lg:flex-1 lg:flex-row lg:gap-5 lg:py-5 lg:pl-5"
    >
      {pairs.map((pair) => (
        <div class:list={['flex gap-[10px] lg:contents', box]}>
          {pair.map((column) => (
            <div class="flex min-w-0 flex-1 flex-col gap-2 lg:gap-1">
              <h3 class="text-body-xs font-medium">{column.title}</h3>
              <ul class="contents">
                {column.links.map((item) => (
                  <li class="text-body-2xs">
                    <a href={item.href} class={link}>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </nav>
  </div>
</footer>
