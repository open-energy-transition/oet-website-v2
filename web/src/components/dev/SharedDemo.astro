---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CtaBanner from '../blocks/CtaBanner.astro'
import LinkListGroup from '../blocks/LinkListGroup.astro'
import ListingHeader from '../blocks/ListingHeader.astro'
import PageHero from '../blocks/PageHero.astro'
import FilterBar from '../ui/FilterBar.astro'
import FilterTabs from '../ui/FilterTabs.astro'
import Pagination from '../ui/Pagination.astro'
import PersonRow from '../ui/PersonRow.astro'
import RichText from '../ui/RichText.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import SortControl from '../ui/SortControl.astro'
import StatItem from '../ui/StatItem.astro'
import {
  authors,
  contact,
  ctaBanners,
  eventStateTabs,
  eventTypeTabs,
  filters,
  gridStats,
  heroes,
  projectLinkGroups,
  publicationLinkGroups,
  richTextImage,
  richTextProject,
  richTextPublication,
  sectionHeadings,
  sort,
  statusTabs,
  stripStats,
  teamTabs,
  toolTabs,
} from '../../data/dev-shared'
import { defaultLocale } from '../../i18n/config'

const hrefFor = (page: number) => `?page=${page}`
---

<BaseLayout
  title="Shared components"
  description="Demo of the shared page parts."
  share={{ image: null, type: 'website' }}
  headerTheme="dark"
  initialHeaderTheme="dark"
>
  <main id="main">
    {heroes.map((hero) => (
      <div data-demo={`hero-${hero.id}`}>
        <PageHero {...hero} />
      </div>
    ))}

    <div data-demo="listing-success">
      <ListingHeader
        layout="stacked"
        title="Success Stories"
        description={
          'Discover our innovative projects driving the energy transition \ntowards a sustainable future with open-source and open data'
        }
        descriptionStyle="body-md-medium"
        tabsWidth="column"
        topSpace={180}
        id="success-stories"
      >
        <FilterTabs
          slot="tabs"
          label="Project status"
          layout="compact"
          mobileBreakAfter={null}
          options={statusTabs}
        />
        <FilterBar slot="controls" locale={defaultLocale} filters={filters} sort={sort} />
        <Pagination
          class="pt-5 lg:hidden"
          current={1}
          total={10}
          hrefFor={hrefFor}
          locale={defaultLocale}
        />
      </ListingHeader>
    </div>

    <div data-demo="listing-news">
      <ListingHeader
        layout="split"
        title="News and Events"
        description="From community meetups to industry forums, each event reflects our commitment to advancing open, transparent, and collaborative solutions for the energy transition."
        descriptionStyle="body-lg"
        tabsWidth="column"
        topSpace={180}
        id="news"
      >
        <FilterTabs
          slot="tabs"
          label="Event state"
          layout="compact"
          mobileBreakAfter={null}
          options={eventStateTabs}
        />
        <FilterTabs
          slot="controls"
          label="Event type"
          layout="compact"
          mobileBreakAfter={null}
          options={eventTypeTabs}
        />
        <SortControl
          slot="controls"
          {...sort}
          id="sort-news"
          icon="sort"
          align="right"
          listing={null}
          class="lg:-ml-px"
        />
      </ListingHeader>
    </div>

    <div data-demo="listing-team">
      <ListingHeader
        layout="split"
        title="Meet The Team"
        description={null}
        descriptionStyle="body-md-medium"
        tabsWidth="wide"
        topSpace={120}
        id="team"
      >
        <FilterTabs
          slot="tabs"
          label="Team group"
          layout="wrap"
          mobileBreakAfter={null}
          options={teamTabs}
        />
        <SortControl
          slot="controls"
          {...sort}
          id="sort-team"
          icon="sort"
          align="right"
          listing={null}
        />
      </ListingHeader>
    </div>

    <div data-demo="tabs-equal" class="max-w-page px-gutter lg:px-gutter-lg mx-auto w-full py-10">
      <FilterTabs label="Tool category" layout="equal" mobileBreakAfter={null} options={toolTabs} />
    </div>

    <div data-demo="pagination" class="px-gutter mx-auto w-full max-w-[412px]">
      <Pagination
        class="pt-5 pb-10"
        current={1}
        total={10}
        hrefFor={hrefFor}
        locale={defaultLocale}
      />
      <Pagination
        class="pt-5 pb-10"
        current={5}
        total={10}
        hrefFor={hrefFor}
        locale={defaultLocale}
      />
      <Pagination
        class="pt-5 pb-10"
        current={10}
        total={10}
        hrefFor={hrefFor}
        locale={defaultLocale}
      />
    </div>

    <div class="max-w-page px-gutter lg:px-gutter-lg mx-auto flex w-full flex-col">
      {sectionHeadings.map((heading, index) => (
        <div data-demo={`heading-${index}`} class="border-b border-neutral-100 py-10">
          <SectionHeading {...heading} />
        </div>
      ))}
    </div>

    <div class="max-w-page px-gutter lg:px-gutter-lg mx-auto grid w-full gap-10 py-20 lg:grid-cols-[727px_305px] lg:gap-[128px]">
      <div class="flex min-w-0 flex-col">
        <div data-demo="richtext-project" class="px-5 pb-[60px]">
          <RichText html={richTextProject} size="lg" />
        </div>
        <div data-demo="links-project">
          <LinkListGroup groups={projectLinkGroups} class="px-5 py-[60px]" />
        </div>
        <div data-demo="richtext-publication" class="px-5 pb-[60px]">
          <RichText html={richTextPublication(richTextImage.src)} size="md" />
        </div>
        <div data-demo="stat-grid" class="grid px-5 pb-[60px] lg:grid-cols-2">
          {gridStats.map((stat) => (
            <StatItem variant="grid" {...stat} class="-mt-px -ml-px" />
          ))}
        </div>
        <div data-demo="links-publication">
          <LinkListGroup groups={publicationLinkGroups} class="px-5 pt-5 pb-[60px]" />
        </div>
      </div>
      <aside class="flex flex-col gap-10">
        <div data-demo="person-contact" class="flex flex-col gap-4 pr-3 pl-5">
          <h2 class="text-heading-3 font-medium text-neutral-800">Contact</h2>
          <PersonRow {...contact} />
        </div>
        <div data-demo="person-authors" class="flex flex-col gap-4 pr-3 pl-5">
          <h2 class="text-body-lg font-medium text-neutral-800">Authors</h2>
          {authors.map((author) => (
            <PersonRow {...author} />
          ))}
        </div>
      </aside>
    </div>

    <div
      data-demo="stat-strip"
      class="max-w-page px-gutter lg:px-gutter-lg mx-auto grid w-full grid-cols-2 pb-20 lg:grid-cols-6"
    >
      {stripStats.map((stat) => (
        <StatItem variant="strip" {...stat} class="-mt-px -ml-px" />
      ))}
    </div>

    <div class="flex flex-col">
      {ctaBanners.map((banner, index) => (
        <div data-demo={`cta-${index}`} class:list={[banner.breakout && 'lg:pt-[136px]']}>
          <CtaBanner {...banner} />
        </div>
      ))}
    </div>
  </main>
</BaseLayout>
