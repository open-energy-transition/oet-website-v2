---
import type { ImageMetadata } from 'astro'
import BrandImage from '../ui/BrandImage.astro'
import Tag from '../ui/Tag.astro'

interface Step {
  title: string
  paragraphs: string[]
  note: string
  image: ImageMetadata
  alt: string
}

interface Props {
  tag: string
  title: string
  steps: Step[]
}

const { tag, title, steps } = Astro.props
---

<oet-steps class="block" data-header-theme="on-red" style={`--steps:${steps.length}`}>
  <section class="steps-panel bg-brand-600 relative mx-auto flex max-w-[1400px] flex-col rounded-lg px-5 pt-[120px] pb-5 lg:pr-20 lg:pb-20 lg:pl-10">
    <div class="flex shrink-0 flex-col items-start gap-[10px] pt-3 pb-8">
      <Tag label={tag} tone="light" />
      <h2 class="text-display-3 font-medium text-white">{title}</h2>
    </div>
    <div class="steps-view mt-5 lg:mt-0">
      <ol class="steps-list flex flex-col gap-5">
        {steps.map((step) => (
          <li class="flex flex-col lg:h-[466px] lg:flex-row">
            <div class="flex flex-col gap-6 border border-neutral-100 p-[39px] font-medium text-white lg:w-1/2 lg:gap-3">
              <h3 class="text-display-5">{step.title}</h3>
              <div class="text-body-xl flex-1 space-y-[1lh]">
                {step.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <p class="text-body-md">{step.note}</p>
            </div>
            <BrandImage
              image={step.image}
              alt={step.alt}
              widths={[373, 640, 746, 1280]}
              sizes="(min-width: 1440px) 640px, (min-width: 1024px) calc(50vw - 80px), calc(100vw - 40px)"
              loading="lazy"
              blocks="none"
              class="aspect-[373/275] lg:aspect-auto lg:w-1/2"
            />
          </li>
        ))}
      </ol>
    </div>
    <div
      class="steps-rail absolute top-[120px] right-10 hidden h-[600px] w-2 border border-white/44"
      aria-hidden="true"
    >
      <span class="steps-thumb absolute -inset-x-px -top-px block border border-white/44 bg-neutral-100 backdrop-blur-[4px]"></span>
    </div>
  </section>
</oet-steps>

<style is:global>
  @media (min-width: 1024px) {
    oet-steps {
      padding-inline: 20px;
    }

    oet-steps[data-enhanced] {
      height: calc(800px + (var(--steps) - 1) * 600px);
    }

    oet-steps[data-enhanced] .steps-panel {
      position: sticky;
      top: min(20px, calc(100vh - 820px));
      height: 800px;
      background-image: linear-gradient(
        var(--color-brand-600) 0 33.333%,
        var(--color-brand-700) 0 66.667%,
        var(--color-brand-900) 0
      );
      background-size: 100% 300%;
      background-position-y: calc(var(--step, 0) * 50%);
      transition: background-position-y 0.3s ease-out;
    }

    oet-steps[data-enhanced] .steps-view {
      flex: 1;
      min-height: 0;
      overflow: clip;
    }

    oet-steps[data-enhanced] .steps-list {
      height: 100%;
      gap: 0;
      transform: translateY(calc(var(--step, 0) * -100%));
      transition: transform 0.3s ease-out;
    }

    oet-steps[data-enhanced] .steps-list > li {
      flex: none;
      height: 100%;
    }

    oet-steps[data-enhanced] .steps-rail {
      display: block;
    }

    oet-steps .steps-thumb {
      height: calc(100% / var(--steps) + 2px);
      transform: translateY(calc(var(--progress, 0) * (600px - 100% - 2px)));
    }
  }
</style>

<script>
  class OetSteps extends HTMLElement {
    connectedCallback() {
      const desktop = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)')
      const total = Number(this.style.getPropertyValue('--steps'))
      let queued = false
      const update = () => {
        queued = false
        const distance = this.offsetHeight - 800
        const progress = Math.min(Math.max(-this.getBoundingClientRect().top / distance, 0), 1)
        const step = Math.round(progress * (total - 1))
        this.dataset.step = String(step)
        this.style.setProperty('--step', String(step))
        this.style.setProperty('--progress', String(progress))
      }
      const onScroll = () => {
        if (queued || !desktop.matches) return
        queued = true
        requestAnimationFrame(update)
      }
      const sync = () => {
        this.toggleAttribute('data-enhanced', desktop.matches)
        if (desktop.matches) update()
      }
      desktop.addEventListener('change', sync)
      addEventListener('scroll', onScroll, { passive: true })
      sync()
    }
  }
  customElements.define('oet-steps', OetSteps)
</script>
