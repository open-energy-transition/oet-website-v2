---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/ui'
import ArrowRight from '../../icons/arrow-right.svg'

type Columns = 4 | 6

interface Logo {
  name: string
  image: ImageMetadata
  width: number
  height: number
}

interface Group {
  label: string
  logos: Logo[]
}

interface Props {
  locale: Locale
  columns: Columns
  slots: number
  groups: Group[]
  link: { label: string; href: string } | null
  class?: string
}

const { locale, columns, slots, groups, link, class: className } = Astro.props
const slotsFor = (index: number) =>
  link !== null && index === groups.length - 1 ? slots - 1 : slots

const grids: Record<Columns, string> = {
  4: 'grid-cols-4',
  6: 'grid-cols-6',
}

const cell =
  'flex h-[120px] items-center justify-center border border-neutral-100 px-1 lg:px-[11px]'
const logoClass =
  'h-auto max-w-full mix-blend-multiply transition-opacity duration-600 ease-out motion-reduce:transition-none'
---

<oet-logo-wall
  class:list={['max-w-page px-gutter lg:px-gutter-lg relative mx-auto block w-full', className]}
>
  <button
    type="button"
    data-logo-pause
    aria-pressed="false"
    hidden
    class="text-body-sm focus-visible:left-gutter lg:focus-visible:left-gutter-lg sr-only z-10 min-h-8 border border-neutral-800 bg-neutral-50 px-3 text-neutral-900 focus-visible:not-sr-only focus-visible:absolute focus-visible:top-3"
  >
    {t(locale, 'logos.pause')}
  </button>
  <div class="sr-only">
    {groups.map((group) => (
      <div>
        <p>{group.label}</p>
        <ul>
          {group.logos.map((logo) => (
            <li>{logo.name}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  {groups.map((group, groupIndex) => (
    <ul
      class:list={['grid', grids[columns]]}
      aria-hidden={link !== null && groupIndex === groups.length - 1 ? undefined : 'true'}
      data-logo-group
    >
      <li
        class="text-body-lg col-span-2 flex h-[120px] items-center border border-neutral-100 px-[39px] font-medium text-neutral-900"
        aria-hidden="true"
      >
        {group.label}
      </li>
      {Array.from({ length: slotsFor(groupIndex) }, (_, index) => group.logos[index]).map((logo) =>
        logo === undefined ? (
          <li class={cell} aria-hidden="true" />
        ) : (
          <li class={cell} aria-hidden="true" data-logo-slot>
            <Image
              src={logo.image}
              alt={logo.name}
              width={logo.width}
              height={logo.height}
              densities={[1, 2, 3]}
              loading="lazy"
              class={logoClass}
            />
          </li>
        ),
      )}
      {link !== null && groupIndex === groups.length - 1 && (
        <li class="flex h-[120px]">
          <a
            href={link.href}
            class="bg-brand-500 text-body-sm flex w-full items-center justify-between gap-3 px-6 font-semibold text-neutral-50"
          >
            <span class="max-w-[137px]">{link.label}</span>
            <ArrowRight class="size-[18px] shrink-0" aria-hidden="true" />
          </a>
        </li>
      )}
      {group.logos.length > slotsFor(groupIndex) && (
        <template data-logo-pool>
          {group.logos.slice(slotsFor(groupIndex)).map((logo) => (
            <Image
              src={logo.image}
              alt={logo.name}
              width={logo.width}
              height={logo.height}
              densities={[1, 2, 3]}
              loading="lazy"
              class:list={[logoClass, 'opacity-0']}
            />
          ))}
        </template>
      )}
    </ul>
  ))}
</oet-logo-wall>

<script>
  const interval = 3000
  const batch = { min: 4, max: 6 }

  interface Rotation {
    slots: HTMLElement[]
    pool: HTMLImageElement[]
  }

  const shuffle = <T,>(items: T[]) => {
    const copy = [...items]
    for (let index = copy.length - 1; index > 0; index -= 1) {
      const other = Math.floor(Math.random() * (index + 1))
      ;[copy[index], copy[other]] = [copy[other], copy[index]]
    }
    return copy
  }

  const swap = (rotation: Rotation, slot: HTMLElement) => {
    const current = slot.querySelector<HTMLImageElement>('img')!
    const next = rotation.pool.shift()!
    current.addEventListener(
      'transitionend',
      async () => {
        current.replaceWith(next)
        rotation.pool.push(current)
        await next.decode()
        next.classList.remove('opacity-0')
      },
      { once: true },
    )
    current.classList.add('opacity-0')
  }

  const swapBatch = (rotations: Rotation[]) => {
    const size = batch.min + Math.floor(Math.random() * (batch.max - batch.min + 1))
    const picks = shuffle(
      rotations.flatMap((rotation) =>
        shuffle(rotation.slots)
          .slice(0, rotation.pool.length)
          .map((slot) => ({ rotation, slot })),
      ),
    ).slice(0, size)
    for (const { rotation, slot } of picks) swap(rotation, slot)
  }

  class OetLogoWall extends HTMLElement {
    timer = 0
    visible = false
    held = false
    paused = false
    observer: IntersectionObserver | null = null

    connectedCallback() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
      const rotations = [...this.querySelectorAll<HTMLElement>('[data-logo-group]')].flatMap(
        (group) => {
          const template = group.querySelector<HTMLTemplateElement>('[data-logo-pool]')
          if (template === null) return []
          const pool = [
            ...document.importNode(template.content, true).children,
          ] as HTMLImageElement[]
          const slots = [...group.querySelectorAll<HTMLElement>('[data-logo-slot]')]
          return [{ slots, pool }]
        },
      )
      if (rotations.length === 0) return
      const button = this.querySelector<HTMLButtonElement>('[data-logo-pause]')!
      button.hidden = false
      const tick = () => swapBatch(rotations)
      const update = () => {
        const running = this.visible && !this.held && !this.paused
        if (running && this.timer === 0) this.timer = window.setInterval(tick, interval)
        if (!running && this.timer !== 0) {
          window.clearInterval(this.timer)
          this.timer = 0
        }
      }
      const hold = (held: boolean) => () => {
        this.held = held
        update()
      }
      this.addEventListener('pointerenter', hold(true))
      this.addEventListener('pointerleave', hold(false))
      button.addEventListener('click', () => {
        this.paused = !this.paused
        button.setAttribute('aria-pressed', String(this.paused))
        update()
      })
      this.observer = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting
        update()
      })
      this.observer.observe(this)
    }

    disconnectedCallback() {
      window.clearInterval(this.timer)
      this.timer = 0
      if (this.observer !== null) this.observer.disconnect()
    }
  }
  customElements.define('oet-logo-wall', OetLogoWall)
</script>
