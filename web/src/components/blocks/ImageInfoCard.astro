---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Button from '../ui/Button.astro'

interface Props {
  image: ImageMetadata
  alt: string
  title: string
  paragraphs: string[]
  action: { label: string; href: string } | null
  class?: string
}

const { image, alt, title, paragraphs, action, class: className } = Astro.props
---

<article
  data-reveal
  class:list={[
    'relative flex flex-col after:pointer-events-none after:absolute after:inset-0 after:border after:border-[#ececec]',
    className,
  ]}
>
  <div class="relative h-[233px] w-full after:pointer-events-none after:absolute after:inset-0 after:border after:border-[#d9cdcd]">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      pictureAttributes={{ class: 'contents' }}
      widths={[305, 458, 534, 610, 909]}
      sizes="305px"
      loading="lazy"
      class="size-full object-cover"
    />
  </div>
  <div class="bg-brand-500 h-1 w-full"></div>
  <div class="flex w-full flex-col items-start gap-3 p-3">
    <div class="flex w-full flex-col gap-[6px]">
      <h3 class="text-[1.125rem] leading-[20px] font-semibold text-neutral-900">{title}</h3>
      {paragraphs.map((paragraph) => (
        <p class="text-body-md text-neutral-800">{paragraph}</p>
      ))}
    </div>
    {action !== null && (
      <Button
        href={action.href}
        label={action.label}
        variant="secondary"
        size="sm-tall"
        arrow={false}
        newTab={false}
      />
    )}
  </div>
</article>
