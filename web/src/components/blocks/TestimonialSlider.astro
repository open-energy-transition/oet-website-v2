---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/ui'

type Variant = 'wide' | 'compact'

interface Testimonial {
  quote: string
  name: string
  role: string
  portrait: ImageMetadata
  logo: ImageMetadata
  company: string
  paragraphs: string[]
}

interface Props {
  variant: Variant
  heading: string
  subline: string | null
  locale: Locale
  items: Testimonial[]
}

const { variant, heading, subline, locale, items } = Astro.props

const styles: Record<
  Variant,
  {
    root: string
    header: string
    heading: string
    panel: string
    quotePanel: string
    textPanel: string
    quote: string
    name: string
    role: string
    portrait: string
    logo: string
    text: string
    portraitSize: number
    logoSize: [number, number]
  }
> = {
  wide: {
    root: 'gap-6',
    header: 'gap-2 pl-5',
    heading: 'text-display-5',
    panel: 'p-10',
    quotePanel: 'lg:w-[660px]',
    textPanel: 'px-5 py-10',
    quote: 'text-heading-1',
    name: 'text-heading-3 font-medium',
    role: 'text-body-md',
    portrait: 'size-20',
    logo: 'h-20 w-[47px]',
    text: 'text-body-md',
    portraitSize: 80,
    logoSize: [47, 80],
  },
  compact: {
    root: 'gap-0',
    header: 'px-5 pb-5',
    heading: 'text-heading-4',
    panel: 'p-5',
    quotePanel: 'lg:w-1/2',
    textPanel: 'p-5',
    quote: 'text-heading-3',
    name: 'text-body-lg font-medium',
    role: 'text-body-xs',
    portrait: 'size-14',
    logo: 'h-14 w-8',
    text: 'text-body-sm',
    portraitSize: 56,
    logoSize: [32, 56],
  },
}

const style = styles[variant]
const multiple = items.length > 1
---

<oet-testimonial-slider class:list={['flex flex-col', style.root]}>
  <div class:list={['flex flex-col text-neutral-800', style.header]}>
    <h2 class:list={['font-medium', style.heading]}>{heading}</h2>
    {subline !== null && <p class="text-body-md font-medium">{subline}</p>}
  </div>
  <div
    role={multiple ? 'region' : undefined}
    aria-label={multiple ? t(locale, 'testimonials.label') : undefined}
  >
    <ul
      class="focus-inset flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] motion-safe:scroll-smooth"
      tabindex={multiple ? 0 : undefined}
      data-track
    >
      {items.map((item) => (
        <li class="flex w-full shrink-0 snap-start flex-col lg:flex-row">
          <figure class="contents">
            <div
              class:list={[
                'bg-brand-500 flex flex-col justify-between gap-3 border border-neutral-100 text-neutral-50',
                style.panel,
                style.quotePanel,
              ]}
            >
              <blockquote class:list={['font-medium', style.quote]}>{item.quote}</blockquote>
              <figcaption class="flex items-center">
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class={style.name}>{item.name}</span>
                  <span class={style.role}>{item.role}</span>
                </span>
                <Image
                  src={item.portrait}
                  alt=""
                  width={style.portraitSize}
                  height={style.portraitSize}
                  densities={[1, 2, 3]}
                  loading="lazy"
                  class:list={['shrink-0 bg-neutral-200 object-cover', style.portrait]}
                />
                <Image
                  src={item.logo}
                  alt={item.company}
                  width={style.logoSize[0]}
                  height={style.logoSize[1]}
                  densities={[1, 2, 3]}
                  loading="lazy"
                  class:list={['shrink-0 bg-neutral-100 object-cover', style.logo]}
                />
              </figcaption>
            </div>
            <div
              class:list={[
                'flex flex-col gap-[1lh] border border-neutral-100 font-medium text-neutral-800 lg:w-0 lg:flex-1',
                style.textPanel,
                style.text,
              ]}
            >
              {item.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </figure>
        </li>
      ))}
    </ul>
  </div>
  {multiple && (
    <div class="flex h-2" data-progress>
      {items.map((_, index) => (
        <button
          type="button"
          class="border-brand-500 aria-[current=true]:bg-brand-500 relative h-2 flex-1 cursor-pointer border before:absolute before:-inset-y-3 before:inset-x-0"
          aria-label={`${t(locale, 'testimonials.show')} ${index + 1}`}
          aria-current={index === 0 ? 'true' : 'false'}
        />
      ))}
    </div>
  )}
</oet-testimonial-slider>

<noscript>
  <style is:inline>
    oet-testimonial-slider [data-progress] {
      display: none;
    }
  </style>
</noscript>

<script>
  class OetTestimonialSlider extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-track]')!
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-progress] button')]
      if (buttons.length === 0) return
      const slides = [...track.children] as HTMLElement[]
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => {
          track.scrollTo({ left: slides[index].offsetLeft - slides[0].offsetLeft })
        })
      })
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            const active = slides.indexOf(entry.target as HTMLElement)
            buttons.forEach((button, index) =>
              button.setAttribute('aria-current', String(index === active)),
            )
          }
        },
        { root: track, threshold: 0.6 },
      )
      slides.forEach((slide) => observer.observe(slide))
    }
  }
  customElements.define('oet-testimonial-slider', OetTestimonialSlider)
</script>
