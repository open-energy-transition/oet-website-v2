---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Columns = 4 | 6
type MobileColumns = 2 | 4
type Inset = 'page' | 'none'

interface Logo {
  name: string
  image: ImageMetadata
  width: number
  height: number
}

interface Group {
  label: string | null
  logos: Logo[]
}

interface Props {
  columns: Columns
  mobileColumns: MobileColumns
  inset: Inset
  groups: Group[]
  facets: Record<string, string>[][] | null
  class?: string
}

const { columns, mobileColumns, inset, groups, facets, class: className } = Astro.props

const facetsOf = (group: number, logo: number) => {
  if (facets === null) return {}
  const values = facets[group]?.[logo]
  if (!values) throw new Error(`LogoGrid: no facets for logo ${logo} of group ${group}`)
  return {
    'data-listing-item': true,
    ...Object.fromEntries(
      Object.entries(values).map(([key, value]) => [`data-facet-${key}`, value]),
    ),
  }
}

const grids: Record<Columns, string> = {
  4: 'lg:grid-cols-4',
  6: 'lg:grid-cols-6',
}

const mobileGrids: Record<MobileColumns, string> = {
  2: 'grid-cols-2',
  4: 'grid-cols-4',
}

const insets: Record<Inset, string> = {
  page: 'max-w-page px-gutter lg:px-gutter-lg mx-auto w-full',
  none: 'w-full',
}
---

<div class:list={[insets[inset], className]}>
  {groups.map((group, groupIndex) => (
    <ul
      class:list={['grid', mobileGrids[mobileColumns], grids[columns]]}
      aria-label={group.label}
      data-listing-items={facets === null ? undefined : true}
    >
      {group.label !== null && (
        <li
          class="text-body-lg col-span-2 flex h-[120px] items-center border border-neutral-100 px-[39px] font-medium text-neutral-900"
          aria-hidden="true"
        >
          {group.label}
        </li>
      )}
      {group.logos.map((logo, logoIndex) => (
        <li
          class="flex h-[120px] items-center justify-center border border-neutral-100 px-1 lg:px-[11px]"
          {...facetsOf(groupIndex, logoIndex)}
        >
          <Image
            src={logo.image}
            alt={logo.name}
            width={logo.width}
            height={logo.height}
            densities={[1, 2, 3]}
            loading="lazy"
            class="h-auto max-w-full mix-blend-multiply"
          />
        </li>
      ))}
    </ul>
  ))}
</div>
