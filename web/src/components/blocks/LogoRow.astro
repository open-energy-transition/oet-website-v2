---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Logo {
  name: string
  image: ImageMetadata
  width: number
  height: number
}

interface Props {
  logos: Logo[]
}

const { logos } = Astro.props
---

<ul class="relative grid h-[240px] before:pointer-events-none before:absolute before:inset-x-0 before:top-1/2 before:border-t before:border-neutral-100 lg:before:hidden auto-rows-fr grid-cols-4 border-y border-neutral-100 px-5 lg:h-[120px] lg:grid-flow-col lg:auto-cols-fr lg:grid-cols-none lg:px-10">
  {logos.map((logo) => (
    <li class="flex min-h-0 items-center justify-center border-x border-neutral-100 max-lg:nth-[4n]:border-r-0 max-lg:nth-[4n+1]:border-l-0 lg:first:border-l-0 lg:last:border-r-0">
      <Image
        src={logo.image}
        alt={logo.name}
        width={logo.width}
        height={logo.height}
        densities={[1, 2, 3]}
        loading="lazy"
        class="h-auto w-[calc(var(--logo-width)/2)] mix-blend-multiply lg:w-(--logo-width)"
        style={`--logo-width:${logo.width}px`}
      />
    </li>
  ))}
</ul>
