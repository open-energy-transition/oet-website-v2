---
import type { SvgComponent } from 'astro/types'

interface Step {
  number: string
  text: string
  icon: SvgComponent
}

interface Props {
  steps: Step[]
  class?: string
}

const { steps, class: className } = Astro.props
---

<ol class:list={['flex flex-col', className]}>
  {steps.map((step) => (
    <li class="flex items-center gap-[10px] border border-neutral-200 p-[15px] font-medium text-neutral-800">
      <span class="text-body-xs w-5 shrink-0 self-start text-right" aria-hidden="true">
        {step.number}
      </span>
      <p class="text-body-md min-w-0 flex-1 whitespace-pre-line">{step.text}</p>
      <step.icon class="size-6 shrink-0 text-neutral-400" aria-hidden="true" />
    </li>
  ))}
</ol>
