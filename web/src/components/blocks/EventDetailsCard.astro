---
import type { ImageMetadata } from 'astro'
import CardShell from '../cards/CardShell.astro'
import Button from '../ui/Button.astro'
import PersonRow from '../ui/PersonRow.astro'
import Calendars from '../../icons/calendars.svg'
import ClockTen from '../../icons/clock-ten.svg'
import LandLocation from '../../icons/land-location.svg'
import MapPin from '../../icons/map-pin.svg'
import EventPoster from './EventPoster.astro'

type Link = { label: string; href: string }
type Contributor = { name: string; title: string; photo: ImageMetadata }
type Footer =
  | { kind: 'actions'; calendar: Link; join: Link }
  | { kind: 'poster'; image: ImageMetadata; alt: string }

interface Props {
  label: string
  title: string
  date: string
  dateTime: string
  location: string
  map: Link
  time: string
  contributorsLabel: string
  contributors: Contributor[]
  footer: Footer
  class?: string
}

const {
  label,
  title,
  date,
  dateTime,
  location,
  map,
  time,
  contributorsLabel,
  contributors,
  footer,
  class: className,
} = Astro.props

const row = 'flex w-full items-center gap-2'
const text = 'min-w-0 flex-1 text-[1rem] leading-none text-[#4a4c56]'
const icon = 'size-5 shrink-0 text-neutral-800'
---

<CardShell
  tab={{ label, tone: 'neutral-800-tint' }}
  body="bare"
  media={null}
  footer="none"
  height="natural"
  class:list={['bg-neutral-50', className]}
>
  <div class="flex w-full flex-col gap-2 p-5">
    <h2 class="text-heading-4 font-medium text-neutral-800">{title}</h2>
    <p class:list={[row, 'pt-3']}>
      <Calendars class={icon} aria-hidden="true" />
      <time datetime={dateTime} class={text}>
        {date}
      </time>
    </p>
    <p class={row}>
      <LandLocation class={icon} aria-hidden="true" />
      <span class={text}>{location}</span>
      <a
        href={map.href}
        aria-label={map.label}
        class="text-brand-500 hover:text-brand-600 shrink-0"
      >
        <MapPin class="size-[18px]" aria-hidden="true" />
      </a>
    </p>
    <p class={row}>
      <ClockTen class={icon} aria-hidden="true" />
      <span class={text}>{time}</span>
    </p>
  </div>
  <div class="flex w-full flex-col gap-3 border-t border-neutral-200 px-5 pt-5 pb-6">
    <h3 class="text-body-lg font-medium text-neutral-800">{contributorsLabel}</h3>
    <ul class="flex flex-col gap-3">
      {contributors.map((person) => (
        <li>
          <PersonRow
            name={person.name}
            title={person.title}
            photo={person.photo}
            role={null}
            links={[]}
          />
        </li>
      ))}
    </ul>
  </div>
  {footer.kind === 'actions' && (
    <div class="flex w-full">
      <Button
        href={footer.calendar.href}
        label={footer.calendar.label}
        variant="secondary"
        size="sm"
        arrow={false}
        newTab={false}
        class="h-[49px] min-w-0 flex-1"
      />
      <Button
        href={footer.join.href}
        label={footer.join.label}
        variant="primary"
        size="sm"
        arrow
        newTab={false}
        class="h-[49px] min-w-0 flex-1"
      />
    </div>
  )}
  {footer.kind === 'poster' && (
    <EventPoster
      image={footer.image}
      alt={footer.alt}
      sizes="(min-width: 1440px) 427px, (min-width: 1024px) 30vw, 100vw"
      priority={false}
    />
  )}
</CardShell>
