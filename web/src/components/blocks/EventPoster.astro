---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  image: ImageMetadata
  alt: string
  sizes: string
  priority: boolean
  class?: string
}

const { image, alt, sizes, priority, class: className } = Astro.props
---

<Image
  src={image}
  alt={alt}
  widths={[412, 824, 847, 1236, 1694]}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['block h-auto w-full', className]}
/>
