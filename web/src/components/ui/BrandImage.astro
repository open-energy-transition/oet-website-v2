---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Blocks = 'none' | 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left'
type Loading = 'lazy' | 'eager'

interface Props {
  image: ImageMetadata
  alt: string
  widths: number[]
  sizes: string
  loading: Loading
  blocks: Blocks
  class?: string
}

const { image, alt, widths, sizes, loading, blocks, class: className } = Astro.props

const anchors: Record<Exclude<Blocks, 'none'>, string> = {
  'bottom-right': 'right-0 bottom-[6.41%]',
  'bottom-left': 'left-0 bottom-[6.41%] -scale-x-100',
  'top-right': 'right-0 top-[6.41%] -scale-y-100',
  'top-left': 'left-0 top-[6.41%] -scale-100',
}
---

<div class:list={['relative overflow-clip', className]}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="absolute inset-0 size-full object-cover"
  />
  {blocks !== 'none' && (
    <div
      class:list={[
        'pointer-events-none absolute grid aspect-[142.37/56.46] w-[22.6%] grid-cols-3 grid-rows-3',
        anchors[blocks],
      ]}
      aria-hidden="true"
    >
      <span class="col-start-2 row-start-1 bg-white" />
      <span class="bg-brand-500 col-start-1 row-start-2" />
      <span class="bg-brand-500 col-start-3 row-start-3" />
    </div>
  )}
</div>
