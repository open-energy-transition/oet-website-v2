---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { PersonSocialKind } from '../../data/socials'
import Bluesky from '../../icons/bluesky.svg'
import CommentHeart from '../../icons/comment-heart.svg'
import Envelope from '../../icons/envelope.svg'
import Eventbrite from '../../icons/eventbrite.svg'
import Github from '../../icons/github.svg'
import Linkedin from '../../icons/linkedin.svg'
import Mastodon from '../../icons/mastodon.svg'
import X from '../../icons/x.svg'
import Youtube from '../../icons/youtube.svg'

type Link = { kind: PersonSocialKind; href: string; label: string }

interface Props {
  name: string
  title: string | null
  photo: ImageMetadata
  role: string | null
  links: Link[]
}

const { name, title, photo, role, links } = Astro.props

const icons: Record<PersonSocialKind, typeof Envelope> = {
  email: Envelope,
  github: Github,
  linkedin: Linkedin,
  message: CommentHeart,
  x: X,
  youtube: Youtube,
  bluesky: Bluesky,
  mastodon: Mastodon,
  eventbrite: Eventbrite,
  newsletter: Envelope,
}
---

<div class="flex items-start gap-2">
  <Image
    src={photo}
    alt=""
    widths={[44, 88, 132]}
    sizes="44px"
    loading="lazy"
    class="bg-brand-500 size-11 shrink-0 object-cover"
  />
  <div class="flex min-w-0 flex-1 flex-col">
    {role && <p class="text-body-2xs font-medium text-neutral-800">{role}</p>}
    <p class="text-body-sm line-clamp-2 font-medium text-neutral-800">{name}</p>
    {title !== null && <p class="text-body-2xs truncate text-neutral-600">{title}</p>}
    {links.length > 0 && (
      <ul class="flex gap-1 pt-2">
        {links.map((link) => {
          const Icon = icons[link.kind]
          return (
            <li>
              <a
                href={link.href}
                aria-label={link.label}
                class="text-brand-500 hover:text-brand-600 block"
              >
                <Icon class="size-[14px]" aria-hidden="true" />
              </a>
            </li>
          )
        })}
      </ul>
    )}
  </div>
</div>
