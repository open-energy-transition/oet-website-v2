---
import ChevronDown from '../../icons/chevron-down.svg'
import Sort from '../../icons/sort.svg'

type Option = { value: string; label: string }

interface Props {
  id: string
  label: string
  prefix: string | null
  icon: 'sort' | 'chevron'
  options: Option[]
  selected: string
  align: 'left' | 'right'
  listing: 'sort' | { facet: string } | null
  class?: string
}

const { id, label, prefix, icon, options, selected, align, listing, class: className } = Astro.props

const current = options.find((option) => option.value === selected)
if (!current) throw new Error(`SortControl "${id}": selected value "${selected}" is not an option`)

const aligns: Record<Props['align'], string> = { left: 'left-0', right: 'right-0' }
---

<oet-select
  class:list={['relative block', className]}
  data-value={selected}
  data-listing-sort={listing === 'sort' ? '' : undefined}
  data-listing-facet={listing !== null && listing !== 'sort' ? listing.facet : undefined}
>
  <button
    type="button"
    id={`${id}-button`}
    class="text-body-sm text-brand-600 border-brand-600 hover:bg-brand-600 aria-expanded:bg-brand-600 relative flex h-10 items-center gap-2 border px-[11px] font-medium whitespace-nowrap transition-colors hover:text-neutral-50 focus-visible:z-20 aria-expanded:text-neutral-50"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-list`}
  >
    <span>
      {prefix ? <span>{prefix}: </span> : <span class="sr-only">{label}: </span>}
      <span data-current>{current.label}</span>
    </span>
    {icon === 'sort' ? (
      <Sort class="size-4 shrink-0" aria-hidden="true" />
    ) : (
      <span class="flex size-4 shrink-0 items-center justify-center">
        <ChevronDown class="h-auto w-[9px]" aria-hidden="true" />
      </span>
    )}
  </button>
  <ul
    id={`${id}-list`}
    role="listbox"
    tabindex="-1"
    aria-label={label}
    class:list={[
      'border-brand-600 absolute top-full z-30 -mt-px min-w-full border bg-neutral-50 py-1 shadow-[0_8px_24px_rgba(25,25,24,0.12)]',
      aligns[align],
    ]}
    hidden
  >
    {options.map((option) => (
      <li
        id={`${id}-option-${option.value}`}
        role="option"
        data-value={option.value}
        aria-selected={option.value === selected ? 'true' : 'false'}
        class="text-body-sm aria-selected:text-brand-600 data-active:bg-neutral-100 cursor-pointer px-3 py-[9px] font-medium whitespace-nowrap text-neutral-800 hover:bg-neutral-100"
      >
        {option.label}
      </li>
    ))}
  </ul>
</oet-select>

<noscript>
  <style is:inline>
    oet-select {
      display: none;
    }
  </style>
</noscript>

<script>
  class OetSelect extends HTMLElement {
    setValue(value: string) {
      const current = this.querySelector('[data-current]')
      const options = [...this.querySelectorAll<HTMLLIElement>('[role="option"]')]
      const option = options.find((item) => item.dataset.value === value)
      if (!current || !option) throw new Error(`oet-select: no option "${value}"`)
      options.forEach((item) =>
        item.setAttribute('aria-selected', item === option ? 'true' : 'false'),
      )
      current.textContent = option.textContent
      this.dataset.value = value
    }

    connectedCallback() {
      const button = this.querySelector('button')
      const list = this.querySelector('ul')
      const current = this.querySelector('[data-current]')
      if (!button || !list || !current) throw new Error('oet-select: missing parts')
      const options = [...list.querySelectorAll<HTMLLIElement>('[role="option"]')]
      let active = options.findIndex((option) => option.getAttribute('aria-selected') === 'true')

      const mark = (index: number) => {
        active = (index + options.length) % options.length
        options.forEach((option, position) =>
          option.toggleAttribute('data-active', position === active),
        )
        list.setAttribute('aria-activedescendant', options[active].id)
        options[active].scrollIntoView({ block: 'nearest' })
      }
      const open = () => {
        list.hidden = false
        button.setAttribute('aria-expanded', 'true')
        mark(options.findIndex((option) => option.getAttribute('aria-selected') === 'true'))
        list.focus()
      }
      const close = (restoreFocus: boolean) => {
        list.hidden = true
        button.setAttribute('aria-expanded', 'false')
        if (restoreFocus) button.focus()
      }
      const choose = (index: number) => {
        const option = options[index]
        options.forEach((item) =>
          item.setAttribute('aria-selected', item === option ? 'true' : 'false'),
        )
        current.textContent = option.textContent
        this.dataset.value = option.dataset.value
        this.dispatchEvent(
          new CustomEvent('oet-select:change', {
            bubbles: true,
            detail: { value: option.dataset.value },
          }),
        )
        close(true)
      }

      button.addEventListener('click', () => (list.hidden ? open() : close(false)))
      button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          open()
        }
      })
      list.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') mark(active + 1)
        else if (event.key === 'ArrowUp') mark(active - 1)
        else if (event.key === 'Home') mark(0)
        else if (event.key === 'End') mark(options.length - 1)
        else if (event.key === 'Enter' || event.key === ' ') choose(active)
        else if (event.key === 'Escape') close(true)
        else if (event.key === 'Tab') {
          close(false)
          return
        } else return
        event.preventDefault()
      })
      list.addEventListener('click', (event) => {
        const option = (event.target as HTMLElement).closest<HTMLLIElement>('[role="option"]')
        if (option) choose(options.indexOf(option))
      })
      this.addEventListener('focusout', (event) => {
        if (!list.hidden && !this.contains(event.relatedTarget as Node | null)) close(false)
      })
    }
  }

  if (!customElements.get('oet-select')) customElements.define('oet-select', OetSelect)
</script>
