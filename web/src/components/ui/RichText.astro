---
interface Props {
  html: string
  size: 'md' | 'lg' | 'lg-md'
  class?: string
}

const { html, size, class: className } = Astro.props
---

<div class:list={['rich-text', className]} data-size={size} set:html={html} />

<style>
  .rich-text {
    overflow-wrap: anywhere;
    color: var(--color-neutral-800);
    font-size: var(--text-body-md);
    font-weight: 500;
    line-height: var(--text-body-md--line-height);
    letter-spacing: -0.01em;
  }

  .rich-text[data-size='lg'] {
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
  }

  @media (width < 64rem) {
    .rich-text[data-size='lg-md'] {
      font-size: var(--text-body-lg);
      line-height: var(--text-body-lg--line-height);
    }
  }

  .rich-text :global(> * + *) {
    margin-top: 1lh;
  }

  .rich-text :global(li + li) {
    margin-top: 1lh;
  }

  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4) {
    font-weight: 500;
  }

  .rich-text :global(h2) {
    font-size: var(--text-heading-1);
    line-height: var(--text-heading-1--line-height);
  }

  .rich-text :global(h3) {
    font-size: var(--text-heading-2);
    line-height: var(--text-heading-2--line-height);
  }

  .rich-text :global(h4) {
    font-size: var(--text-heading-3);
    line-height: var(--text-heading-3--line-height);
  }

  .rich-text :global(> * + h2),
  .rich-text :global(> * + h3),
  .rich-text :global(> * + h4) {
    margin-top: 60px;
  }

  .rich-text :global(> h2 + *),
  .rich-text :global(> h3 + *),
  .rich-text :global(> h4 + *) {
    margin-top: 16px;
  }

  .rich-text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .rich-text :global(a:hover) {
    color: var(--color-brand-600);
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.5em;
  }

  .rich-text :global(ul) {
    list-style: disc;
  }

  .rich-text :global(ol) {
    list-style: decimal;
  }

  .rich-text :global(strong) {
    font-weight: 700;
  }

  .rich-text :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 16px;
  }

  .rich-text :global(figure) {
    margin-top: 16px;
  }

  .rich-text :global(figcaption) {
    margin-top: 8px;
    color: var(--color-neutral-600);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
  }

  .rich-text :global(blockquote) {
    border-left: 1px solid var(--color-brand-500);
    padding-left: 20px;
    font-style: italic;
  }
</style>
