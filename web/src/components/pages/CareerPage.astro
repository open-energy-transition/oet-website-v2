---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NumberedStepList from '../blocks/NumberedStepList.astro'
import PageHero from '../blocks/PageHero.astro'
import JobCard from '../cards/JobCard.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { loadCareerPage } from '../../data/career'
import { defaultLocale } from '../../i18n/config'

const { meta, hero, roles, hiring } = await loadCareerPage(defaultLocale)
const rowLine =
  'lg:nth-[3n+1]:before:absolute lg:nth-[3n+1]:before:top-0 lg:nth-[3n+1]:before:left-0 lg:nth-[3n+1]:before:h-px lg:nth-[3n+1]:before:w-[300%] lg:nth-[3n+1]:before:bg-neutral-100'
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  share={{ image: null, type: 'website' }}
  headerTheme="dark"
  initialHeaderTheme="light"
>
  <main id="main">
    <PageHero
      layout="photo-left"
      title={hero.title}
      titleSize="display-2"
      titleSizeMobile="display-3"
      eyebrow={null}
      lead={hero.lead}
      links={[]}
      stats={{
        groups: [
          [
            { kind: 'icon', icon: hero.icon, tone: 'light' },
            { kind: 'count', value: hero.count.value, label: hero.count.label, tone: 'outline' },
          ],
        ],
        action: { href: hero.action.href, label: hero.action.label, icon: 'arrow-down' },
      }}
      person={null}
      image={hero.image}
      background="brand-600"
      textLeft={96}
      mobileAnchor="top-180"
      ornament="photo-right"
      headerTheme="light"
    />
    <div class="max-w-page px-gutter lg:px-gutter-lg mx-auto w-full">
      <section
        id={roles.id}
        class="-scroll-mt-[62px] lg:-scroll-mt-[82px] border-l border-neutral-100 pb-[120px] lg:border-r lg:border-b lg:pb-[100px]"
      >
        <SectionHeading
          layout="stack"
          tag={roles.tag}
          title={roles.title}
          level="h2"
          gap={8}
          width="narrow"
          titleTone="neutral-900"
          linkTone="text"
          align="center"
          subline={null}
          columns={roles.columns}
          columnStyle="body-lg"
          actions={[]}
          class="pt-[192px] pb-16 pl-[19px] lg:pt-[132px] lg:pr-3 lg:pb-6"
        />
        <ul class="-ml-px grid grid-cols-1 gap-y-5 lg:-mr-px lg:grid-cols-3">
          {roles.jobs.map((job) => (
            <li class:list={['relative min-w-0', rowLine]}>
              <JobCard {...job} locale={defaultLocale} />
            </li>
          ))}
        </ul>
      </section>

      <section class="flex flex-col border-l border-neutral-100 pt-[192px] pb-[120px] lg:flex-row lg:pt-20 lg:pb-10">
        <div class="flex flex-col gap-2 pb-[34px] pl-[19px] lg:w-1/2 lg:gap-4 lg:pr-5 lg:pb-[60px]">
          <h2 class="text-display-5 lg:text-heading-2 font-medium text-neutral-800">
            {hiring.title}
          </h2>
          <div class="text-body-lg lg:text-body-md flex flex-col gap-[22px] text-neutral-800 lg:gap-[19px] lg:font-medium">
            {hiring.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <NumberedStepList
          steps={hiring.steps}
          class="pr-5 pl-[19px] lg:w-1/2 lg:px-5 lg:pt-[47px] lg:pb-[60px]"
        />
      </section>
    </div>
  </main>
</BaseLayout>
