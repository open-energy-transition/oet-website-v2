---
import ListingHeader from '../blocks/ListingHeader.astro'
import PageHero from '../blocks/PageHero.astro'
import TestimonialSlider from '../blocks/TestimonialSlider.astro'
import ProjectCard from '../cards/ProjectCard.astro'
import ListingFilter from '../interactive/ListingFilter.astro'
import FilterBar from '../ui/FilterBar.astro'
import FilterTabs from '../ui/FilterTabs.astro'
import Pagination from '../ui/Pagination.astro'
import { loadFilters, sort } from '../../data/outputs'
import { loadSuccessStories } from '../../data/projects'
import { routes } from '../../data/routes'
import { defaultLocale } from '../../i18n/config'
import { t } from '../../i18n/ui'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { firstPageClass, sortByNewest } from '../../lib/listing'

const locale = defaultLocale
const [{ meta, hero, listing, testimonials }, filters] = await Promise.all([
  loadSuccessStories(locale),
  loadFilters(locale, 'projects'),
])
const hrefFor = (page: number) => `${routes.successStories}?page=${page}#${listing.id}`
const items = sortByNewest(listing.items, (project) => project.date)
const initialStatus = 'completed'
const shown = items.filter((project) => project.facets.status === initialStatus)
const totalPages = (size: number) => Math.max(1, Math.ceil(shown.length / size))
const container = 'max-w-page px-gutter lg:px-gutter-lg mx-auto w-full'
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  share={{ image: null, type: 'website' }}
  headerTheme="dark"
  initialHeaderTheme="light"
>
  <main id="main">
    <PageHero
      layout="listing"
      title={hero.title}
      titleSize="display-2"
      titleSizeMobile="display-5"
      eyebrow={null}
      lead={[]}
      links={hero.links}
      stats={null}
      person={null}
      image={hero.image}
      background="brand-700"
      chipsBottomMobile={62}
      ornament="left-upper"
      headerTheme="light"
    />

    <ListingFilter pageSize={listing.pageSize} ranked={false} infinite={false}>
      <ListingHeader
        layout="stacked"
        title={listing.title}
        description={listing.description}
        descriptionStyle="body-md-medium"
        tabsWidth="column"
        topSpace={180}
        id={listing.id}
      >
        <div slot="tabs" data-listing-tabs="status">
          <FilterTabs
            label={t(locale, 'tabs.projectStatus')}
            layout="compact"
            mobileBreakAfter={null}
            options={listing.tabs}
          />
        </div>
        <FilterBar
          slot="controls"
          locale={locale}
          filters={filters}
          sort={sort(locale, 'projects', 'newest')}
        />
        <Pagination
          class="py-5 lg:hidden"
          current={1}
          total={totalPages(listing.pageSize.mobile)}
          hrefFor={hrefFor}
          locale={locale}
        />
      </ListingHeader>

      <div class={container}>
        <ul
          data-listing-items
          aria-live="polite"
          class="grid scroll-mt-32 gap-5 border-t border-neutral-100 py-5 lg:grid-cols-3 lg:gap-y-10 lg:border-l lg:pl-5"
        >
          {items.map((project) => {
            const index = shown.indexOf(project)
            return (
              <li
                class:list={index === -1 ? [] : firstPageClass(index, listing.pageSize)}
                hidden={index === -1}
                data-listing-item
                data-facet-status={project.facets.status}
                data-facet-region={project.facets.region}
                data-facet-service={project.facets.service}
                data-facet-product={project.facets.product}
                data-facet-tag={project.facets.tag}
                data-title={project.title}
                data-date={project.date}
              >
                <ProjectCard
                  title={project.title}
                  titleLines={2}
                  excerpt={project.excerpt}
                  period={project.period}
                  href={routes.successStory(project.slug)}
                  linkLabel={t(locale, 'card.viewProject')}
                  image={project.thumbnail}
                  alt={project.alt}
                  sizes="(min-width: 1440px) 367px, (min-width: 1024px) calc((100vw - 340px) / 3), calc(100vw - 80px)"
                  frame={project.frame}
                  mobileFrame="fixed"
                  height="fixed"
                  partnerTag={project.partnerTag}
                  partnerLink={project.partnerLink}
                  footer="when-partner"
                  class="h-full"
                />
              </li>
            )
          })}
        </ul>
        <p
          data-listing-empty
          class="text-body-md border-neutral-100 py-10 pl-5 font-medium text-neutral-800 lg:border-l"
          hidden={shown.length > 0}
        >
          {t(locale, 'projects.empty')}
        </p>
        <div class="flex justify-center border-neutral-100 pt-10 pb-15 lg:border-l">
          <Pagination
            class="w-full lg:w-93"
            current={1}
            total={totalPages(listing.pageSize.desktop)}
            hrefFor={hrefFor}
            locale={locale}
          />
        </div>
      </div>
    </ListingFilter>
    <div class={container}>
      <div class="border-l border-neutral-100 py-45">
        <TestimonialSlider
          variant="wide"
          heading={testimonials.heading}
          subline={testimonials.subline}
          locale={locale}
          items={testimonials.items}
        />
      </div>
    </div>
  </main>
</BaseLayout>
