---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import GlobeAlt from '../../icons/globe-alt.svg'
import PeopleGroup from '../../icons/people-group.svg'

interface Props {
  photos: { photo: ImageMetadata; alt: string; codes: string[] }[]
  selected: string
  country: string
  count: string
  unit: string
  class?: string
}

const { photos, selected, country, count, unit, class: className } = Astro.props

const chip =
  'text-body-sm text-brand-500 border-brand-500 flex h-[41px] items-center gap-2 border bg-neutral-50 px-[11px] font-medium whitespace-nowrap'
---

<div class:list={['flex w-[305px] flex-col items-start', className]}>
  <div class="relative -mb-px h-[233px] w-full overflow-clip border border-[#d9cdcd]">
    {photos.map(({ photo, alt, codes }) => (
      <Image
        src={photo}
        alt={alt}
        widths={[305, 610]}
        sizes="305px"
        loading="lazy"
        class="absolute inset-0 size-full object-cover"
        hidden={!codes.includes(selected)}
        data-globe-photo={codes.join(' ')}
      />
    ))}
  </div>
  <div class="bg-brand-500 relative -mb-px h-1 w-full"></div>
  <p class="relative flex items-center">
    <span class={chip}>
      <GlobeAlt class="size-4" aria-hidden="true" />
      <span data-globe-card="country">{country}</span>
    </span>
    <span class="bg-brand-500 border-brand-500 text-brand-50 flex h-[41px] w-10 items-center justify-center border">
      <PeopleGroup class="size-4" aria-hidden="true" />
    </span>
    <span class={chip}>
      <span data-globe-card="count">{count}</span>
      <span>{unit}</span>
    </span>
  </p>
</div>
