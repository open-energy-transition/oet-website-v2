---
import type { ImageMetadata } from 'astro'
import type { SvgComponent } from 'astro/types'
import { Image } from 'astro:assets'
import ArrowRight from '../../icons/arrow-right.svg'

type Variant = 'full' | 'compact'
type Accent = 'red' | 'dark-red' | 'charcoal' | 'plum'

interface Props {
  variant: Variant
  name: string
  lead: string
  summary: string
  accent: Accent
  icon: SvgComponent
  head: { name: string; role: string; photo: ImageMetadata }
  link: { label: string; href: string } | null
  image: { desktop: ImageMetadata; mobile: ImageMetadata } | null
  class?: string
}

const {
  variant,
  name,
  lead,
  summary,
  accent,
  icon: Icon,
  head,
  link,
  image,
  class: className,
} = Astro.props

const accents: Record<Accent, string> = {
  red: 'bg-brand-500',
  'dark-red': 'bg-brand-700',
  charcoal: 'bg-neutral-900',
  plum: 'bg-brand-900',
}

const icons: Record<Variant, string> = {
  full: 'size-5 lg:size-8',
  compact: 'size-8',
}

const heads: Record<Variant, string> = {
  full: 'flex-col items-start lg:flex-row lg:items-end',
  compact: 'items-end',
}
---

<article
  class:list={[
    'relative flex flex-col after:pointer-events-none after:absolute after:inset-0 after:border after:border-neutral-100',
    className,
  ]}
>
  <div class="flex min-h-[107px] w-full items-start gap-2 lg:h-[107px]">
    <div class="flex min-w-0 flex-1 flex-col gap-1 pt-5 pl-5 font-medium text-neutral-800">
      <h3 class="text-heading-4 lg:truncate">{name}</h3>
      <p class="text-body-md h-[58px] overflow-clip">{lead}</p>
    </div>
    <div
      class:list={['flex shrink-0 items-center justify-center self-stretch p-4', accents[accent]]}
    >
      <Icon class:list={['text-brand-50', icons[variant]]} aria-hidden="true" />
    </div>
  </div>
  <div class="flex w-full flex-col gap-3 py-5">
    <p class="text-body-md mr-16 ml-5 line-clamp-3 h-[59px] text-neutral-600">{summary}</p>
    <div class:list={['flex gap-3 px-5', heads[variant]]}>
      <Image
        src={head.photo}
        alt=""
        widths={[44, 88, 132]}
        sizes="44px"
        loading="lazy"
        class="border-brand-500 size-11 shrink-0 border-b bg-neutral-200 object-cover"
      />
      <div class="flex w-full min-w-0 flex-1 flex-col gap-1 text-neutral-800">
        <p class="text-body-md font-medium">{head.name}</p>
        <p class="text-body-xs truncate">{head.role}</p>
      </div>
      {link !== null && (
        <a
          href={link.href}
          class="text-body-md flex shrink-0 items-center gap-[6px] font-medium whitespace-nowrap text-brand-600 after:absolute after:inset-0 focus-stretched"
        >
          {link.label}
          <ArrowRight class="h-[9px] w-4 shrink-0" aria-hidden="true" />
        </a>
      )}
    </div>
  </div>
  {image !== null && (
    <div class:list={['w-full px-5 pt-5', accents[accent]]}>
      <Image
        src={image.mobile}
        alt=""
        widths={[332, 664]}
        sizes="(min-width: 412px) 664px, calc(100vw - 80px)"
        loading="lazy"
        class="h-[238px] w-full object-cover lg:hidden"
      />
      <Image
        src={image.desktop}
        alt=""
        widths={[580, 1160]}
        sizes="(min-width: 1440px) 580px, calc(50vw - 140px)"
        loading="lazy"
        class="hidden h-[238px] w-full object-cover lg:block"
      />
    </div>
  )}
</article>
