---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/ui'
import esmLarge from '../../assets/organization/jobs/energy-system-modeling-large.jpg'
import esmSmall from '../../assets/organization/jobs/energy-system-modeling-small.jpg'
import financeLarge from '../../assets/organization/jobs/finance-large.jpg'
import financeSmall from '../../assets/organization/jobs/finance-small.jpg'
import gridLarge from '../../assets/organization/jobs/grid-data-large.jpg'
import gridSmall from '../../assets/organization/jobs/grid-data-small.jpg'
import miscLarge from '../../assets/organization/jobs/miscellaneous-large.jpg'
import miscSmall from '../../assets/organization/jobs/miscellaneous-small.jpg'
import toolsLarge from '../../assets/organization/jobs/modeling-tools-large.jpg'
import toolsSmall from '../../assets/organization/jobs/modeling-tools-small.jpg'
import peopleLarge from '../../assets/organization/jobs/people-culture-large.jpg'
import peopleSmall from '../../assets/organization/jobs/people-culture-small.jpg'
import researchLarge from '../../assets/organization/jobs/research-market-development-large.jpg'
import researchSmall from '../../assets/organization/jobs/research-market-development-small.jpg'
import softwareLarge from '../../assets/organization/jobs/software-engineering-large.jpg'
import softwareSmall from '../../assets/organization/jobs/software-engineering-small.jpg'
import ArrowRight from '../../icons/arrow-right.svg'
import DictionaryAlt from '../../icons/dictionary-alt.svg'
import Diploma from '../../icons/diploma.svg'
import Laptop from '../../icons/laptop.svg'
import Marker from '../../icons/marker.svg'

type Theme =
  | 'finance'
  | 'people-and-culture'
  | 'software-engineering'
  | 'research-and-market-development'
  | 'modeling-tools-and-data'
  | 'energy-system-modeling'
  | 'grid-data'
  | 'miscellaneous'

interface Props {
  title: string
  location: string
  languages: string
  workMode: string
  employmentType: string
  href: string
  newTab: boolean
  theme: Theme
  locale: Locale
  class?: string
}

const {
  title,
  location,
  languages,
  workMode,
  employmentType,
  href,
  newTab,
  theme,
  locale,
  class: className,
} = Astro.props

const thumbnails: Record<Theme, { large: ImageMetadata; small: ImageMetadata }> = {
  finance: { large: financeLarge, small: financeSmall },
  'people-and-culture': { large: peopleLarge, small: peopleSmall },
  'software-engineering': { large: softwareLarge, small: softwareSmall },
  'research-and-market-development': { large: researchLarge, small: researchSmall },
  'modeling-tools-and-data': { large: toolsLarge, small: toolsSmall },
  'energy-system-modeling': { large: esmLarge, small: esmSmall },
  'grid-data': { large: gridLarge, small: gridSmall },
  miscellaneous: { large: miscLarge, small: miscSmall },
}

const thumbnail = thumbnails[theme]
const row = 'flex items-center gap-2'
const value = 'text-body-sm min-w-0 flex-1 font-medium text-neutral-900'
const icon = 'w-4 shrink-0 text-neutral-800'
---

<article
  class:list={[
    'relative flex flex-col after:pointer-events-none after:absolute after:inset-0 after:border after:border-neutral-100',
    className,
  ]}
>
  <div class="flex w-full flex-col items-start gap-2 p-5">
    <div class="flex w-full flex-col gap-1">
      <h3 class="text-heading-4 line-clamp-2 h-[52px] font-medium text-neutral-800">
        <a
          href={href}
          target={newTab ? '_blank' : undefined}
          rel={newTab ? 'noopener noreferrer' : undefined}
          class="after:absolute after:inset-0 after:z-10 focus-stretched"
        >
          {title}
        </a>
      </h3>
      <dl class="flex flex-wrap gap-1">
        <div class:list={[row, 'w-full pt-2']}>
          <dt class="sr-only">{t(locale, 'job.location')}</dt>
          <Marker class:list={[icon, 'h-4']} aria-hidden="true" />
          <dd class={value}>{location}</dd>
        </div>
        <div class:list={[row, 'w-full pt-1']}>
          <dt class="sr-only">{t(locale, 'job.languages')}</dt>
          <DictionaryAlt class:list={[icon, 'h-4']} aria-hidden="true" />
          <dd class={value}>{languages}</dd>
        </div>
        <div class:list={[row, 'min-w-0 flex-1 pt-1']}>
          <dt class="sr-only">{t(locale, 'job.workMode')}</dt>
          <Laptop class:list={[icon, 'h-3']} aria-hidden="true" />
          <dd class={value}>{workMode}</dd>
        </div>
        <div class:list={[row, 'min-w-0 flex-1 pt-1']}>
          <dt class="sr-only">{t(locale, 'job.employmentType')}</dt>
          <Diploma class:list={[icon, 'h-4']} aria-hidden="true" />
          <dd class={value}>{employmentType}</dd>
        </div>
      </dl>
    </div>
    <p
      class="flex items-center gap-[6px] pt-2 text-[0.875rem] leading-none font-semibold tracking-[-0.01em] text-brand-600"
      aria-hidden="true"
    >
      {t(locale, 'job.seeBoard')}
      <ArrowRight class="h-2 w-[15px] shrink-0" />
    </p>
  </div>
  <Image
    src={thumbnail.small}
    alt=""
    widths={[372, 744]}
    sizes="(min-width: 412px) 744px, calc(100vw - 40px)"
    loading="lazy"
    class="h-[258px] w-full object-cover lg:hidden"
  />
  <Image
    src={thumbnail.large}
    alt=""
    widths={[427, 854]}
    sizes="(min-width: 1440px) 427px, calc(33.33vw - 54px)"
    loading="lazy"
    class="hidden h-[258px] w-full object-cover lg:block"
  />
</article>
