---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import CardBody from './CardBody.astro'
import CardShell from './CardShell.astro'
import type { CardHeight, FrameTone, MobileFrame } from './types'

interface Media {
  image: ImageMetadata
  alt: string
  sizes: string
  frame: FrameTone
  mobileFrame: MobileFrame
}

interface Props {
  title: string
  excerpt: string
  date: string
  category: string | null
  href: string
  linkLabel: string
  media: Media | null
  height: CardHeight
  class?: string
}

const {
  title,
  excerpt,
  date,
  category,
  href,
  linkLabel,
  media,
  height,
  class: className,
} = Astro.props

const shellMedia =
  media === null
    ? null
    : { kind: 'framed' as const, tone: media.frame, mobile: media.mobileFrame, badge: false }
---

<CardShell
  tab={null}
  body="fixed"
  media={shellMedia}
  footer={category === null ? 'none' : 'content'}
  height={height}
  class={className}
>
  <CardBody
    title={title}
    titleLines={2}
    excerpt={excerpt}
    meta={date}
    href={href}
    linkLabel={linkLabel}
  />
  {media !== null && (
    <Image
      slot="media"
      src={media.image}
      alt={media.alt}
      widths={[332, 367, 664, 734]}
      sizes={media.sizes}
      loading="lazy"
      class="absolute inset-0 size-full object-cover"
    />
  )}
  {category !== null && (
    <p slot="footer" class="truncate">
      {category}
    </p>
  )}
</CardShell>
