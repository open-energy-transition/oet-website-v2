---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { Locale } from '../../i18n/config'
import { t } from '../../i18n/ui'
import type { TeamProfile } from '../../data/team'
import ArrowRight from '../../icons/arrow-right.svg'
import GraduationDiploma from '../../icons/graduation-diploma.svg'
import StudentAlt from '../../icons/student-alt.svg'
import { personSocialLabels, type PersonSocialKind } from '../../data/socials'
import bluesky from '../../icons/bluesky.svg?url&no-inline'
import commentHeart from '../../icons/comment-heart.svg?url&no-inline'
import envelope from '../../icons/envelope.svg?url&no-inline'
import eventbrite from '../../icons/eventbrite.svg?url&no-inline'
import github from '../../icons/github.svg?url&no-inline'
import linkedin from '../../icons/linkedin.svg?url&no-inline'
import mastodon from '../../icons/mastodon.svg?url&no-inline'
import x from '../../icons/x.svg?url&no-inline'
import youtube from '../../icons/youtube.svg?url&no-inline'

type Box = { x: number; y: number; width: number; height: number }

interface Props {
  name: string
  role: string
  portrait: {
    image: ImageMetadata
    kind: 'cut-out' | 'photo'
    desktop: Box
    mobile: Box
    rotate: number
  }
  glow: 'center' | 'right'
  links: { kind: PersonSocialKind; href: string }[]
  profile: TeamProfile
  tags: string[]
  locale: Locale
  class?: string
}

const { name, role, portrait, glow, links, profile, tags, locale, class: className } = Astro.props

const icons: Record<PersonSocialKind, string> = {
  email: envelope,
  github,
  linkedin,
  message: commentHeart,
  x,
  youtube,
  bluesky,
  mastodon,
  eventbrite,
  newsletter: envelope,
}

const glows: Record<Props['glow'], string> = {
  center: 'left-[calc(50%-128px)]',
  right: 'left-[calc(50%-111px)] lg:left-[calc(50%-85px)]',
}

const frames = { desktop: 280, mobile: 332 }
const placed = (box: Box, frame: number) => ({
  x: `${box.x - frame / 2}px`,
  y: `${box.y}px`,
  width: `${box.width}px`,
  height: `${box.height}px`,
})
const desktop = placed(portrait.desktop, frames.desktop)
const mobile = placed(portrait.mobile, frames.mobile)
const rendered = Math.ceil(
  Math.max(
    portrait.desktop.width,
    portrait.desktop.height,
    portrait.mobile.width,
    portrait.mobile.height,
  ),
)

const section = 'w-full border border-neutral-100'
const blend = portrait.kind === 'photo' ? 'mix-blend-multiply' : ''
const educationIcons = { doctorate: GraduationDiploma, degree: StudentAlt }
---

<article class:list={['flex flex-col', className]}>
  <div class:list={['relative h-[258px] overflow-clip bg-neutral-50', section]}>
    <div class="absolute inset-x-[19px] top-[19px] h-[238px]">
      <div
        class:list={[
          'absolute top-[98px] h-[280.11px] w-[256.63px] rounded-full bg-[#f7c7bf] opacity-60 blur-[27.4px]',
          glows[glow],
        ]}
      ></div>
      <Image
        src={portrait.image}
        alt=""
        widths={[rendered, rendered * 2]}
        sizes={`${rendered}px`}
        loading="lazy"
        class:list={[
          'absolute top-(--my) left-[calc(50%+var(--mx))] h-(--mh) w-(--mw) max-w-none object-cover lg:top-(--dy) lg:left-[calc(50%+var(--dx))] lg:h-(--dh) lg:w-(--dw)',
          blend,
        ]}
        style={{
          '--mx': mobile.x,
          '--my': mobile.y,
          '--mw': mobile.width,
          '--mh': mobile.height,
          '--dx': desktop.x,
          '--dy': desktop.y,
          '--dw': desktop.width,
          '--dh': desktop.height,
          rotate: `${portrait.rotate}deg`,
        }}
      />
    </div>
  </div>
  <div class:list={['flex flex-col gap-3 p-[19px]', section]}>
    <div class="flex h-[46px] flex-col gap-1 font-medium">
      <h3 class="text-heading-4 truncate text-neutral-800">{name}</h3>
      <p class="text-body-sm truncate text-neutral-600">{role}</p>
    </div>
    <div class="flex h-[14px] items-start gap-1">
      <ul class="text-brand-500 flex gap-1">
        {links.map((link) => (
          <li class="flex">
            <a
              class="relative flex size-[14px] before:absolute before:-inset-[5px]"
              href={link.href}
              aria-label={`${t(locale, personSocialLabels[link.kind])}: ${name}`}
            >
              <span
                class="size-[14px] bg-current"
                style={{ mask: `url("${icons[link.kind]}") center / contain no-repeat` }}
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        data-profile-open
        aria-haspopup="dialog"
        aria-label={`${profile.label}: ${name}`}
        class="text-brand-600 relative ml-auto flex h-[14px] cursor-pointer items-center gap-[6px] text-[0.875rem] leading-none font-semibold tracking-[-0.01em] before:absolute before:-inset-y-[5px] before:inset-x-0 hover:underline"
      >
        {profile.label}
        <ArrowRight class="h-2 w-[15px]" aria-hidden="true" />
      </button>
    </div>
  </div>
  <p class:list={['text-body-sm h-[41px] truncate py-[11px] pl-[19px] text-neutral-600', section]}>
    {tags.join(' | ')}
  </p>
  <template data-profile>
    <div class="flex flex-col gap-3">
      <div class="flex gap-3 border-b border-neutral-100">
        <div class="relative h-[126px] w-[139px] shrink-0 self-start overflow-clip border border-neutral-100 bg-neutral-50 lg:h-auto lg:w-[158px] lg:self-stretch">
          <div class="absolute top-[52px] left-[calc(50%-74px)] h-[136px] w-[148px] rounded-full bg-[#f7c7bf] opacity-65 blur-[14.5px]"></div>
          <Image
            src={portrait.image}
            alt=""
            widths={[148, 296]}
            sizes="148px"
            loading="lazy"
            class:list={[
              'absolute top-[calc(50%+11.66px)] left-[-1.79%] aspect-square w-[105.36%] max-w-none -translate-y-1/2 object-cover',
              blend,
            ]}
          />
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-2 pt-2 pb-3">
          <div class="flex flex-col gap-1">
            <h2 class="text-heading-4 font-medium text-neutral-800 lg:truncate" data-profile-title>
              {`${t(locale, 'team.profile.about')} ${name}`}
            </h2>
            <p class="text-body-sm text-neutral-600 lg:truncate">{tags.join(' | ')}</p>
          </div>
          {profile.education.length === 0 && <div class="h-11" aria-hidden="true" />}
          {profile.education.length > 0 && (
            <ul
              class="flex min-h-11 flex-col gap-2 pt-1"
              aria-label={t(locale, 'team.profile.education')}
            >
              {profile.education.map((entry) => {
                const Icon = educationIcons[entry.kind]
                return (
                  <li class="flex items-center gap-2">
                    <Icon class="size-4 shrink-0 text-neutral-800" aria-hidden="true" />
                    <span class="text-body-xs font-medium text-neutral-900">{entry.degree}</span>
                  </li>
                )
              })}
            </ul>
          )}
          <ul class="text-brand-500 flex gap-2 pt-1">
            {links.map((link) => (
              <li class="flex">
                <a
                  class="relative flex size-[14px] before:absolute before:-inset-[5px]"
                  href={link.href}
                  aria-label={`${t(locale, personSocialLabels[link.kind])}: ${name}`}
                >
                  <span
                    class="size-[14px] bg-current"
                    style={{ mask: `url("${icons[link.kind]}") center / contain no-repeat` }}
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {profile.biographyHtml !== null && (
        <div
          class="text-body-md text-neutral-900 lg:pl-[170px] [&_a]:underline [&_li]:ml-5 [&_ul]:list-disc [&>*+*]:mt-[1lh]"
          set:html={profile.biographyHtml}
        />
      )}
    </div>
  </template>
</article>
